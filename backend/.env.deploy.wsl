APP_ENV=deploy.wsl

# WSL2 / Linux 部署
DATABASE_URL=sqlite:///./storage/app.db
MEDIA_ROOT=./storage/media
MODEL_CATALOG_PATH=./model_catalog.json
MODEL_CATALOG_STRICT=true
OLLAMA_BASE_URL=http://host:11434

# Docker 容器内访问宿主机服务，使用 compose 的 host-gateway 别名 host
OPENAI_LOCAL_BASE_URL=http://host:18000/v1
OPENAI_LOCAL_UPSTREAM_SERVICE_BASE_URL=http://host:18000/v1
OPENAI_LOCAL_API_KEY=sk-local
OPENAI_LOCAL_STREAM=true

# OpenAI Codex
CODEX_BASE_URL=https://ai.router.team/v1
CODEX_API_KEY=sk-h56kMeR6XrSFpHX1kK2I8y1bYeSxNahs8ErEbBhDn0U4Tw1K
CODEX_MODEL_ALLOWLIST=gpt-5.2,gpt-5.4

# Gemini
GEMINI_BASE_URL=https://api.ikuncode.cc
GEMINI_API_KEY=sk-oXSiEaOjWXFf5GC1CRDkcmHqFSkK2WBL9ssLEh15tm9pLK99

# 默认模型
DEFAULT_PROVIDER=openai_local
DEFAULT_MODEL=openai_local:claude-opus-4-6

# 知识库存储
KNOWLEDGE_STORAGE_ROOT=./storage/knowledge
KNOWLEDGE_EMBEDDING_MODEL=qwen3-embedding:0.6b
KNOWLEDGE_RERANK_MODEL=openai:deepseek-chat
IMAGE_VISION_MODEL=/models/Florence-2-base-ft

# Web search
WEB_SEARCH_TRANSLATION_MODEL=codex:gpt-5.2
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODEL=codex:gpt-5.2
RAG_QUERY_REWRITE_HISTORY_MESSAGES=6

# 部署环境按需开启
AUDIO_TRANSCRIPTION_ENABLED=true
AUDIO_TRANSCRIPTION_EAGER_LOAD=true
AUDIO_TRANSCRIPTION_MODEL=iic/SenseVoiceSmall
AUDIO_TRANSCRIPTION_DEVICE=cpu
