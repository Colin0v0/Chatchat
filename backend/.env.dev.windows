APP_ENV=dev.windows

# Windows 本地开发
DATABASE_URL=sqlite:///./storage/app.db
MEDIA_ROOT=./storage/media
MODEL_CATALOG_PATH=./model_catalog.json
MODEL_CATALOG_STRICT=true

# 推荐把 SSH 隧道开在 Windows 本机：
# ssh -N -L 18000:127.0.0.1:8000 user@remote-host
OPENAI_LOCAL_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_LOCAL_API_KEY=sk-local
OPENAI_LOCAL_STREAM=true

# 默认模型
DEFAULT_PROVIDER=openai_local
DEFAULT_MODEL=openai_local:claude-sonnet-4-6

# Windows 路径
RAG_VAULT_PATH=E:/Your/Obsidian/Vault
RAG_INDEX_PATH=./storage/rag/index.json
IMAGE_VISION_MODEL=F:/AI/Models/Florence-2-base-ft

# 本地开发可先关掉音频，避免 funasr 没装导致服务起不来
AUDIO_TRANSCRIPTION_ENABLED=false
AUDIO_TRANSCRIPTION_EAGER_LOAD=false
