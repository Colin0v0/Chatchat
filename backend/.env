# ================================
# WSL2 部署环境变量配置
# ================================
# 使用说明：
# 1. 复制此文件到 backend/.env
# 2. 根据实际情况修改路径和配置
# 3. 在WSL2中启动前确保本地模型目录和上游服务可访问
# ================================

APP_ENV=dev.windows

MODEL_CACHE_ROOT=F:\AI\Models

# OpenAI兼容服务
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-c4dd8705c3274539bfa48120f0e0c598

# Gemini 原生服务
GEMINI_BASE_URL=https://api.ikuncode.cc
GEMINI_API_KEY=sk-oXSiEaOjWXFf5GC1CRDkcmHqFSkK2WBL9ssLEh15tm9pLK99

# 本地OpenAI服务
OPENAI_LOCAL_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_LOCAL_UPSTREAM_SERVICE_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_LOCAL_API_KEY=sk-local
OPENAI_LOCAL_STREAM=true

#trio服务
TRIO_BASE_URL=https://pytrio.cn/api/v1
TRIO_API_KEY=9rH2sQuezWjgd8nWaSAFU
TRIO_MODEL_PATH=ucqm27rwnr/t359dymlgfcs/weights/chat-huanhuan-qwen3-4b-async


# 模型配置
MODEL_CATALOG_PATH=./model_catalog.json
MODEL_CATALOG_STRICT=true
MODEL_CACHE_ROOT=F:\AI\Models

DEFAULT_PROVIDER=codex
DEFAULT_MODEL=codex:gpt-5.2

# 数据库
DATABASE_URL=sqlite:///./storage/app.db

# 网络搜索
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_API_KEY=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
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TOP_K=4
WEB_SEARCH_MIN_SCORE=0.2
WEB_SEARCH_CONTENT_MAX_CHARS=1600
WEB_SEARCH_TRANSLATION_MODEL=codex:gpt-5.2

# 检索配置
RETRIEVAL_CONTEXT_TOP_K=6
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODEL=codex:gpt-5.2
RAG_QUERY_REWRITE_HISTORY_MESSAGES=6

# 知识库配置
KNOWLEDGE_STORAGE_ROOT=./storage/knowledge
KNOWLEDGE_EMBEDDING_MODEL=../models/Qwen3-Embedding-0___6B
KNOWLEDGE_EMBEDDING_DEVICE=cpu
KNOWLEDGE_RERANK_MODEL=openai:deepseek-chat
KNOWLEDGE_RERANK_MAX_CHARS=480
KNOWLEDGE_RERANK_MAX_CONCURRENCY=1
KNOWLEDGE_RERANK_NUM_CTX=512
KNOWLEDGE_MAX_FILE_SIZE_BYTES=2097152
KNOWLEDGE_MAX_DOCUMENTS_PER_USER=100
KNOWLEDGE_MAX_TOTAL_SIZE_BYTES=104857600
KNOWLEDGE_TOP_K=5
KNOWLEDGE_SECTION_MAX_CHARS=1400
KNOWLEDGE_CANDIDATE_LIMIT=4
KNOWLEDGE_RERANK_WINDOW=2
KNOWLEDGE_NEIGHBOR_WINDOW=0
KNOWLEDGE_MIN_SCORE=0.22

MODEL_MAX_CONCURRENCY_PER_MODEL=2

# 图像处理
IMAGE_TEXT_MAX_CHARS=4800

# 视觉模型
IMAGE_VISION_MODEL=/models/Florence-2-base-ft
IMAGE_VISION_PROMPT=<MORE_DETAILED_CAPTION>
IMAGE_VISION_MAX_NEW_TOKENS=320
IMAGE_VISION_NUM_BEAMS=4
IMAGE_VISION_SUMMARY_MAX_CHARS=1200
IMAGE_VISION_DEVICE=cpu

# 音频转录 
AUDIO_TRANSCRIPTION_MODEL=iic/SenseVoiceSmall
AUDIO_TRANSCRIPTION_DEVICE=cpu
