# ================================
# WSL2 部署环境变量配置
# ================================
# 使用说明：
# 1. 复制此文件到 backend/.env
# 2. 根据实际情况修改路径和配置
# 3. 在WSL2中启动前确保ollama已安装运行
# ================================

# Ollama配置 
# Docker容器访问WSL2主机的IP通常是172.17.0.1（docker0网桥）
OLLAMA_BASE_URL=http://172.17.0.1:11434

# OpenAI兼容服务
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-c4dd8705c3274539bfa48120f0e0c598

# 本地OpenAI服务
OPENAI_LOCAL_BASE_URL=http://host.docker.internal:18000/v1
OPENAI_LOCAL_UPSTREAM_SERVICE_BASE_URL=http://host.docker.internal:18000/v1
OPENAI_LOCAL_API_KEY=sk-local
OPENAI_LOCAL_STREAM=true

# 模型配置
MODEL_CATALOG_PATH=./model_catalog.json
MODEL_CATALOG_STRICT=true

DEFAULT_PROVIDER=openai_local
DEFAULT_MODEL=claude-opus-4-6

# 数据库
DATABASE_URL=sqlite:///./storage/app.db

# 网络搜索
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_API_KEY=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
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TOP_K=4
WEB_SEARCH_MIN_SCORE=0.2
WEB_SEARCH_CONTENT_MAX_CHARS=1600
WEB_SEARCH_TRANSLATION_MODEL=openai_local:claude-haiku-4-5

# 检索配置
RETRIEVAL_CONTEXT_TOP_K=6

# RAG配置
RAG_VAULT_PATH=/data/obsidian
RAG_INDEX_PATH=./storage/rag/index.json
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_SECTION_MAX_CHARS=1400
RAG_CANDIDATE_LIMIT=12
RAG_RERANK_WINDOW=12
RAG_NEIGHBOR_WINDOW=1
RAG_MIN_SCORE=0.22

# 图像处理
IMAGE_TEXT_MAX_CHARS=4800

# 视觉模型
IMAGE_VISION_MODEL=/models/Florence-2-base-ft
IMAGE_VISION_PROMPT=<MORE_DETAILED_CAPTION>
IMAGE_VISION_MAX_NEW_TOKENS=320
IMAGE_VISION_NUM_BEAMS=4
IMAGE_VISION_SUMMARY_MAX_CHARS=1200
IMAGE_VISION_DEVICE=cpu

# 音频转录 
AUDIO_TRANSCRIPTION_MODEL=iic/SenseVoiceSmall
AUDIO_TRANSCRIPTION_DEVICE=cpu
