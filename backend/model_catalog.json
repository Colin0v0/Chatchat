{
  "providers": {
    "openai_default": {
      "provider": "openai",
      "api_key_env": "OPENAI_API_KEY"
    },
    "trio_default": {
      "provider": "trio",
      "base_url": "${TRIO_BASE_URL}",
      "api_key_env": "TRIO_API_KEY"
    },
    "codex_default": {
      "provider": "codex",
      "base_url": "${CODEX_BASE_URL}",
      "api_key_env": "CODEX_API_KEY"
    },
    "gemini_default": {
      "provider": "gemini",
      "base_url": "${GEMINI_BASE_URL}",
      "api_key_env": "GEMINI_API_KEY"
    },
    "openai_local_router": {
      "provider": "openai_local",
      "base_url": "${OPENAI_LOCAL_BASE_URL}",
      "upstream_service_base_url": "${OPENAI_LOCAL_UPSTREAM_SERVICE_BASE_URL}",
      "api_key_env": "OPENAI_LOCAL_API_KEY"
    }
  },
  "models": [
    {
      "id": "openai:deepseek-chat",
      "display_name": "DeepSeek Chat",
      "provider_ref": "openai_default",
      "upstream_model": "deepseek-chat",
      "thinking_mode": "force_off",
      "context_window": 200000,
      "native_multimodal": "false",
      "enabled": true
    },
    {
      "id": "openai:deepseek-reasoner",
      "display_name": "DeepSeek Reasoner",
      "provider_ref": "openai_default",
      "upstream_model": "deepseek-reasoner",
      "thinking_mode": "force_on",
      "context_window": 200000,
      "native_multimodal": "false",
      "enabled": true
    },
    {
      "id": "trio:custom-model",
      "display_name": "Trio-嬛嬛",
      "provider_ref": "trio_default",
      "upstream_model": "${TRIO_MODEL_PATH}",
      "thinking_mode": "force_off",
      "context_window": 32000,
      "native_multimodal": "false",
      "enabled": true
    },
    {
      "id": "openai_local:claude-sonnet-4-6",
      "display_name": "Claude Sonnet 4.6",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-sonnet-4-6",
      "thinking_mode": "force_off",
      "context_window": 200000,
      "native_multimodal": "local",
      "enabled": true
    },
    {
      "id": "openai_local:claude-haiku-4-5",
      "display_name": "Claude Haiku 4.5",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-haiku-4-5",
      "thinking_mode": "force_on",
      "context_window": 200000,
      "native_multimodal": "false",
      "enabled": true

    },
    {
      "id": "openai_local:claude-opus-4-6",
      "display_name": "Claude Opus 4.6",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-opus-4-6",
      "thinking_mode": "force_on",
      "context_window": 200000,
      "native_multimodal": "false",
      "enabled": true
    },
    {
      "id": "codex:gpt-5.2",
      "display_name": "GPT-5.2",
      "provider_ref": "codex_default",
      "upstream_model": "gpt-5.2",
      "thinking_mode": "force_off",
      "context_window": 200000,
      "native_multimodal": "codex",
      "enabled": true
    },
    {
      "id": "codex:gpt-5.4",
      "display_name": "GPT-5.4",
      "provider_ref": "codex_default",
      "upstream_model": "gpt-5.4",
      "thinking_mode": "force_off",
      "context_window": 200000,
      "native_multimodal": "codex",
      "enabled": true
    },
    {
      "id": "gemini:gemini-3-flash",
      "display_name": "Gemini 3 Flash",
      "provider_ref": "gemini_default",
      "upstream_model": "gemini-3-flash",
      "thinking_mode": "force_off",
      "context_window": 200000,
      "native_multimodal": "gemini",
      "enabled": true
    }
  ]
}
