{
  "providers": {
    "openai_default": {
      "provider": "openai",
      "api_key_env": "OPENAI_API_KEY"
    },
    "openai_local_router": {
      "provider": "openai_local",
      "base_url": "${OPENAI_LOCAL_BASE_URL}",
      "upstream_service_base_url": "${OPENAI_LOCAL_UPSTREAM_SERVICE_BASE_URL}",
      "api_key_env": "OPENAI_LOCAL_API_KEY"
    },
    "ollama_local": {
      "provider": "ollama",
      "base_url": "${OLLAMA_BASE_URL}"
    }
  },
  "models": [
    {
      "id": "openai:deepseek-chat",
      "display_name": "DeepSeek Chat",
      "provider_ref": "openai_default",
      "upstream_model": "deepseek-chat",
      "thinking_mode": "force_off",
      "context_window": 1000000,
      "native_multimodal": false,
      "enabled": true
    },
    {
      "id": "openai:deepseek-reasoner",
      "display_name": "DeepSeek Reasoner",
      "provider_ref": "openai_default",
      "upstream_model": "deepseek-reasoner",
      "thinking_mode": "default_on",
      "context_window": 1000000,
      "native_multimodal": false,
      "enabled": true
    },
    {
      "id": "openai_local:claude-sonnet-4-6",
      "display_name": "Claude Sonnet 4.6",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-sonnet-4-6",
      "thinking_mode": "default_on",
      "context_window": 1000000,
      "native_multimodal": true,
      "enabled": true
    },
    {
      "id": "openai_local:claude-haiku-4-5",
      "display_name": "Claude Haiku 4.5",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-haiku-4-5",
      "thinking_mode": "default_on",
      "context_window": 1000000,
      "native_multimodal": false,
      "enabled": true

    },
    {
      "id": "openai_local:claude-opus-4-6",
      "display_name": "Claude Opus 4.6",
      "provider_ref": "openai_local_router",
      "upstream_model": "claude-opus-4-6",
      "thinking_mode": "default_on",
      "context_window": 1000000,
      "native_multimodal": false,
      "enabled": true
    },
    {
      "id": "ollama:gemma4:e4b",
      "display_name": "Gemma4 e4b",
      "provider_ref": "ollama_local",
      "upstream_model": "gemma4:e4b",
      "thinking_mode": "default_on",
      "context_window": 32768,
      "native_multimodal": false,
      "enabled": false
    },
    {
      "id": "ollama:huihui-qwen35-9b-opus:latest",
      "display_name": "Qwen3.5 9b unsensored",
      "provider_ref": "ollama_local",
      "upstream_model": "huihui-qwen35-9b-opus:latest",
      "thinking_mode": "default_on",
      "context_window": 32768,
      "native_multimodal": false,
      "enabled": false
    },
    {
      "id": "ollama:deepseek-r1:7b",
      "display_name": "DeepSeek-r1 7b",
      "provider_ref": "ollama_local",
      "upstream_model": "deepseek-r1:7b",
      "thinking_mode": "default_on",
      "context_window": 32768,
      "native_multimodal": false,
      "enabled": false
    },
    {
      "id": "ollama:qwen3:4b",
      "display_name": "Qwen3 4b",
      "provider_ref": "ollama_local",
      "upstream_model": "qwen3:4b",
      "thinking_mode": "default_on",
      "context_window": 32768,
